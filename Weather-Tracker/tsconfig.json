{
  "compilerOptions": {
    "target": "es6",
    "module": "Node16", 
    "moduleResolution": "Node16",
    "outDir": "./dist", 
    "rootDir": "./", 
    "esModuleInterop": true, 
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowJs": true
  },
  "include": [
    "client/**/*",  // Include client-side files
    "server/**/*"   // Include server-side files
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}